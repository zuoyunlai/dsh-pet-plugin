{
  "name": "dsh-pet-plugin",
  "version": "1.19.6",
  "description": "DSH 桌宠插件：四只超写实立绘（表情 + 动作序列）、主动说话与神经音色、小输入框单聊（一次性模型调用，不进会话）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.webp",
    "tools/tts_worker.py",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "tests/*.mjs",
    "tests/fixtures/*.cjs",
    "!tests/_*.mjs",
    "src/*.js",
    "build.mjs",
    "AUDIT-contract.md",
    "pets/*/pack.json",
    "assets/*.webm",
    "lib/*.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "pet",
    "tts",
    "companion"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node tests/smoke.mjs && node --test tests/host.test.mjs tests/assets.test.mjs tests/runtime.test.mjs tests/push-api.test.mjs tests/voice.test.mjs",
    "prepublishOnly": "node build.mjs && node --check index.js && node tests/smoke.mjs && node --test tests/host.test.mjs tests/assets.test.mjs tests/runtime.test.mjs tests/push-api.test.mjs tests/voice.test.mjs",
    "gen": "node tools/gen-personas.cjs",
    "gen:check": "node tools/gen-personas.cjs --check"
  },
  "author": {
    "name": "zuoyunlai",
    "url": "https://github.com/zuoyunlai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyunlai/dsh-pet-plugin.git"
  },
  "homepage": "https://github.com/zuoyunlai/dsh-pet-plugin#readme",
  "bugs": {
    "url": "https://github.com/zuoyunlai/dsh-pet-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
