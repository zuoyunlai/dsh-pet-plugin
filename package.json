{
  "name": "dsh-pet-plugin",
  "version": "1.28.0",
  "description": "DSH 桌面伴侣插件：五只超写实立绘（表情 + 动作序列）、主动说话与神经音色、小输入框单聊（一次性模型调用，不进会话）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.webp",
    "tools/tts_worker.py",
    "tools/gen-personas.cjs",
    "tools/push-via-api.cjs",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "tests/*.mjs",
    "tests/fixtures/*.cjs",
    "tests/assets-manifest.json",
    "tests/voices.json",
    "!tests/_*.mjs",
    "src/*.js",
    "build.mjs",
    "AUDIT-contract.md",
    "pets/*/pack.json",
    "assets/*.webm",
    "lib/*.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1,
    "capabilities": [
      "tools:register",
      "fs:read",
      "network:egress"
    ],
    "commitments": {
      "no-session-upload": true,
      "no-third-party-proxy": true,
      "no-credential-enumeration": true,
      "no-webhook-auto-session": true,
      "third-party-endpoint-disclosure": true
    },
    "compatibility": {
      "dsh": ">=0.2.1-alpha.2 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ],
      "dshReleases": {
        "0.2.1-rc.2": "unknown"
      },
      "dshOperations": {
        "0.2.1-rc.2": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      }
    },
    "disclosure": {
      "endpoints": [
        "speech.platform.bing.com（edge-tts 神经音色，可选增强；未装 edge-tts 或合成失败时退回浏览器本地 speechSynthesis）"
      ],
      "retention": "全部留在本机：设置与单聊历史在 $DSH_HOME/dsh-pet/state.json，神经音色缓存在 $DSH_HOME/dsh-pet/tts-cache（上限 60MB）；立绘与动作随插件包安装。不自动上传、不自动删除。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "pet",
    "tts",
    "companion"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.2 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node tests/smoke.mjs && node --test tests/host.test.mjs tests/assets.test.mjs tests/runtime.test.mjs tests/push-api.test.mjs tests/voice.test.mjs tests/overlay.dom.test.mjs tests/focus.test.mjs tests/notify.test.mjs tests/readme.test.mjs tests/state.test.mjs",
    "prepublishOnly": "node build.mjs && node --check index.js && node tests/smoke.mjs && node --test tests/host.test.mjs tests/assets.test.mjs tests/runtime.test.mjs tests/push-api.test.mjs tests/voice.test.mjs tests/overlay.dom.test.mjs tests/focus.test.mjs tests/notify.test.mjs tests/readme.test.mjs tests/state.test.mjs",
    "gen": "node tools/gen-personas.cjs",
    "gen:check": "node tools/gen-personas.cjs --check"
  },
  "author": {
    "name": "zuoyunlai",
    "url": "https://github.com/zuoyunlai"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyunlai/dsh-pet-plugin.git"
  },
  "homepage": "https://github.com/zuoyunlai/dsh-pet-plugin#readme",
  "bugs": {
    "url": "https://github.com/zuoyunlai/dsh-pet-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
